# Bu dosyayı .env olarak kopyalama - gerçek değerleri sadece
# Vercel'in "Environment Variables" ayarına gir, buraya yazma.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Kendi seçtiğin, uzun ve tahmin edilemez bir metin (şifre gibi düşün).
# Bu, sadece SEN'in veri güncellemesini tetikleyebilmen için kullanılır.
REFRESH_SECRET=uzun-ve-tahmin-edilemez-kendi-sifren-buraya
